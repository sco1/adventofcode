use std::fs;

fn main() {
    let puzzle_input = fs::read_to_string(concat!(env!("CARGO_MANIFEST_DIR"), "/puzzle_input.txt"))
        .expect("Could not read puzzle input");
    let puzzle_input = puzzle_input.trim();

    println!("Part One: {}", y${year}_d${day}::part_one(puzzle_input));
    println!("Part Two: {}", y${year}_d${day}::part_two(puzzle_input));
}
